        "selector": ":scope > p",
        "optional": false
      }
    ],
    "tolerance": 2,
    "reason": "STYLE.md: Measure and layout. Paragraphs retain one continuous top-to-bottom reading order.",
    "severity": "error",
    "optional": true,
    "designRules": [
      "DR-006",
      "DR-007"
    ]
  },
  {
    "id": "essay-prose-alignment",
    "type": "style",
    "selector": ".sc-section-copy > p",
    "property": "text-align",
    "allowed": [
      "left",
      "start"
    ],
    "reason": "STYLE.md: Measure and layout. Center the reading column and keep prose left-aligned. Logical start is left only with the companion left-to-right rule.",
    "severity": "error",
    "optional": true,
    "designRules": [
      "DR-006",
      "DR-007"
    ]
  },
  {
    "id": "essay-prose-columns",
