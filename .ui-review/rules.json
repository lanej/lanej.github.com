    "allowed": [
      "auto",
      "1"
    ],
    "reason": "STYLE.md: Measure and layout. Preserve one prose column, including on wide screens, at enlarged text sizes, and in print.",
    "severity": "error",
    "optional": true,
    "designRules": [
      "DR-006",
      "DR-007"
    ]
  },
  {
    "id": "essay-prose-direction",
